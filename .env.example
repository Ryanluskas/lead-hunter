# Lead Hunter — Environment Configuration Example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL Database & Auth)
# URL de conexão em pool (porta 6543) para queries da aplicação
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:6543/postgres?pgbouncer=true"
# URL de conexão direta (porta 5432) para migrações do Prisma
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL=https://[SEU-PROJETO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform (Places API New & Maps JS)
# Chave de navegador com restrição HTTP referrer para renderizar mapa
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Chave de servidor protegida (restrita à API Places New) para buscas seguras via backend (FieldMask)
GOOGLE_MAPS_PLACES_SERVER_KEY=

# Google Gemini Flash AI (Server-side)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Modo Demonstração (Permite testar com dados comerciais representativos sem gastar cotas enquanto não há chaves)
NEXT_PUBLIC_DEMO_MODE=true
